{
    # Certificados por subdominio, emitidos al primer acceso. Antes de emitir, Caddy pregunta
    # al servidor si el subdominio es un negocio activo: evita emitir certificados para
    # subdominios inventados (abuso de rate limit de Let's Encrypt).
    on_demand_tls {
        ask http://server:3000/internal/tls-check
    }
}

# Cada negocio vive en <slug>.dosuxsoft.com — el servidor identifica el negocio por el Host.
*.dosuxsoft.com {
    tls {
        on_demand
    }

    root * /srv

    # API REST → Fastify (servicio Docker "server")
    handle /api/* {
        reverse_proxy server:3000
    }

    # Auth endpoints — prefijo /auth, no /api
    handle /auth/* {
        reverse_proxy server:3000
    }

    # Health check
    handle /health {
        reverse_proxy server:3000
    }

    # /internal/* (tls-check) NO se expone: solo Caddy lo llama dentro de la red Docker.

    # SPA: servir archivos estáticos, fallback a index.html para React Router
    handle {
        try_files {path} /index.html
        file_server
    }

    # Security headers (CLAUDE.md §6.6)
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'"
        -Server
    }

    encode gzip zstd
}

# El dominio raíz no es un negocio. Placeholder hasta tener landing/registro (Fase F).
dosuxsoft.com, www.dosuxsoft.com {
    header -Server
    respond "Dosuxsoft POS" 200
}
