# ── SIPNATO POS — Variables de entorno PRODUCCIÓN ─────────────────────────────
# Copiar este archivo como "deploy/.env" y completar todos los valores.
# NUNCA subir .env al repositorio.

# Secreto de sesión — mínimo 64 caracteres aleatorios
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIAR_POR_VALOR_ALEATORIO_DE_96_CHARS

# Origen permitido para CORS (sin barra al final)
ALLOWED_ORIGIN=https://www.dosuxsoft.com

# Token del API SDDE del BCCR para el tipo de cambio del dólar (opcional).
# Registro en https://www.bccr.fi.cr/indicadores-economicos/servicio-web
# Sin token, cada negocio usa el tipo de cambio de respaldo de su Configuración.
BCCR_API_TOKEN=
