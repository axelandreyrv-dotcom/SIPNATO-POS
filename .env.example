# ─────────────────────────────────────────────────────────────────────────────
# SIPNATO POS — Variables de entorno
# En desarrollo NO se necesita este archivo — el servidor tiene defaults seguros.
# En producción: copiar a .env, descomentar y completar los valores marcados con (*)
# NUNCA subir .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=development
PORT=3000

# CORS — en producción: https://www.sipnato.com
ALLOWED_ORIGIN=http://localhost:5173

# Base de datos
DATABASE_PATH=./data/sipnato.db
BACKUP_PATH=./data/backups
LOG_PATH=./logs

# (*) Sesión — OBLIGATORIO en producción, mínimo 64 caracteres aleatorios
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=

# Token del puente de impresión (hash argon2id del token real, no el token en sí)
# Se genera desde la UI de Configuración — dejar comentado hasta entonces
# PRINT_BRIDGE_TOKEN_HASH=
