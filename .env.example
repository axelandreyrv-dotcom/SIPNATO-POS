# ─────────────────────────────────────────────────────────────────────────────
# Dosuxsoft POS — Variables de entorno
# En desarrollo NO se necesita este archivo — el servidor tiene defaults seguros.
# En producción: copiar a .env, descomentar y completar los valores marcados con (*)
# NUNCA subir .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=development
PORT=3000

# CORS — en producción: https://www.dosuxsoft.com
ALLOWED_ORIGIN=http://localhost:5173

# Datos: control.db (registro de negocios) + tenants/<slug>.db + backups/<slug>/
DATA_DIR=./data
LOG_PATH=./logs

# Multi-negocio: cada negocio vive en <slug>.<TENANT_BASE_DOMAIN>
# Desarrollo: "localhost" → http://taller.localhost:5173   ·   Producción: dosuxsoft.com
TENANT_BASE_DOMAIN=localhost
# Solo desarrollo: negocio usado al abrir http://localhost:5173 sin subdominio (opcional)
# DEV_TENANT=taller

# (*) Sesión — OBLIGATORIO en producción, mínimo 64 caracteres aleatorios
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=
