# ─────────────────────────────────────────────────────────────────────────────
# Dosuxsoft POS — Variables de entorno
# En desarrollo NO se necesita este archivo — el servidor tiene defaults seguros.
# En producción: copiar a .env, descomentar y completar los valores marcados con (*)
# NUNCA subir .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=development
PORT=3000

# CORS — en producción: https://www.dosuxsoft.com
ALLOWED_ORIGIN=http://localhost:5173

# Base de datos
DATABASE_PATH=./data/dosuxsoft.db
BACKUP_PATH=./data/backups
LOG_PATH=./logs

# (*) Sesión — OBLIGATORIO en producción, mínimo 64 caracteres aleatorios
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=
