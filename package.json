{
  "name": "dosuxsoft",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "prepare": "pnpm --filter @dosuxsoft/shared build",
    "dev": "concurrently --kill-others -n server,web -c bgBlue.bold,bgGreen.bold \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "pnpm --filter @dosuxsoft/server run dev",
    "dev:web": "wait-on tcp:localhost:8787 && pnpm --filter @dosuxsoft/web run dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "wait-on": "^8.0.0"
  }
}
